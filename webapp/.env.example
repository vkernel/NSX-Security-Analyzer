# Generate separate random values with: python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=nsx
POSTGRES_USER=nsx
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=10
# Optional external PostgreSQL: use compose.remote.yaml as described in README.md.
# POSTGRES_HOST=postgres.customer.example
# Remote mode defaults to verify-full; bundled mode defaults to prefer.
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=system
# Or specify a CA file path mounted into web, worker and migrate containers.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_PORT=8000
NSX_AUDIT_TIMEOUT=3600
# For an HTTPS reverse proxy, set the trusted external origin and both flags.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=0

# Optional published image tag when using compose.hub.yaml (default: 0.2.0).
# NSX_IMAGE_TAG=0.2.0
