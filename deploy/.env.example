# Supply two independent random secrets. Never commit your populated .env.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
NSX_IMAGE_TAG=0.5.1
WEB_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For an HTTPS reverse proxy, configure the public origin and proxy settings.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=0

# Container logging: json (default) or text. Audit retention is independent of snapshots.
NSX_LOG_FORMAT=json
# 0 keeps audit events indefinitely; positive values remove expired events in batches.
NSX_AUDIT_LOG_RETENTION_DAYS=0
